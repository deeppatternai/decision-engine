{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "audit",
  "version": "0.2.13-remote",
  "description": "Hosted Deep Pattern audits over an isolated remote MCP connection.",
  "author": {
    "name": "Deep Pattern"
  },
  "license": "MIT",
  "mcpServers": "./mcp.json",
  "skills": "./skills/",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Deep Pattern Audit",
        "shortDescription": "Run Hosted Deep Pattern audits.",
        "longDescription": "Connect with browser activation, run Hosted audits without a local runtime, and follow progress in a cross-platform Web UI.",
        "developerName": "Deep Pattern",
        "category": "Productivity"
      }
    },
    "com.nousresearch.hermes": {
      "servers": {
        "audit": {
          "trust": "untrusted",
          "timeout": 900
        }
      }
    }
  }
}
